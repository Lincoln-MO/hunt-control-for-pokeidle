{
  "manifest_version": 3,
  "name": "Hunt Control for PokeIdle",
  "short_name": "Hunt Control",
  "version": "0.1.9",
  "author": "Lincoln Martins",
  "description": "Analisa hunts, permite hunt fixa, repõe estoque e automatiza Pokédex e Top Catch semanal com VIP.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/boot.js",
        "src/jogo-bundle.js",
        "src/hook.js",
        "src/game.js",
        "src/ritmo.js",
        "src/engine.js",
        "src/geo.js",
        "src/ui.js",
        "src/adapter.js",
        "src/auto.js",
        "src/pix.js",
        "src/prey.js"
      ]
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/ui.css"
      ]
    }
  ]
}
